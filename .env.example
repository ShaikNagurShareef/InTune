# Postgres (Neon in production)
DATABASE_URL=postgres://user:pass@host:5432/intune
# 32+ random characters: openssl rand -base64 48
AUTH_SECRET=
# Private Vercel Blob store (optional locally; media falls back to .data/media)
BLOB_READ_WRITE_TOKEN=
# Protects the retention cron endpoint
CRON_SECRET=
# Optional shared AI keys (people's own keys in Settings take priority). Gemini is tried first.
GEMINI_API_KEY=
OPENAI_API_KEY=
# Live calls (optional; call buttons are hidden without these). LiveKit Cloud (free tier) or self-hosted.
# Local dev: `livekit-server --dev` → ws://localhost:7880 with devkey / secret
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
